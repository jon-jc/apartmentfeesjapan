# Copy to .env.local (dev) or set in your hosting dashboard (production).

# Canonical site URL, no trailing slash — used in metadata, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense publisher ID (adsense.google.com → Account information).
# Leave unset until you're approved — the site renders no ad code without it.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# Ad unit slot IDs (AdSense → Ads → By ad unit → create "Display ad" → copy data-ad-slot).
NEXT_PUBLIC_ADSENSE_SLOT_HOME=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_WARD=0000000000
